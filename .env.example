# Copy this file to .env.local for local development or configure real environment variables in production.
# Never commit real passwords, APP_SECRET values, or production credentials.

APP_ENV=dev
APP_SECRET=change-me-generate-with-bin-console-secrets-or-random-hex
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# PostgreSQL example. Add a password in your uncommitted local/prod env if needed.
DATABASE_URL="postgresql://app@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

APP_SECURITY_PASSWORD_MIN_LENGTH=12
APP_COOKIE_CONSENT_ENABLED=true
APP_UPLOAD_MAX_SIZE_MB=20
APP_MATOMO_ENABLED=false
APP_MATOMO_SITE_ID=1
APP_MATOMO_BASE_URL=
MAP_BASEMAP_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_BASEMAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_BASEMAP_MAX_ZOOM=19

# Microsoft Entra ID / Office 365 SSO (OIDC)
APP_SSO_O365_ENABLED=false
APP_SSO_O365_TENANT_ID=
APP_SSO_O365_CLIENT_ID=
APP_SSO_O365_CLIENT_SECRET=
APP_SSO_O365_SCOPE="openid profile email"
APP_SSO_O365_ROLE_CLAIM=roles
APP_SSO_O365_ROLE_MAP='{"SIG_ADMIN":"ROLE_ADMIN","SIG_AGENT":"ROLE_AGENT"}'
APP_SSO_O365_DEFAULT_INTERNAL_ROLE=ROLE_AGENT
APP_SSO_O365_ALLOWED_TENANT_IDS='[]'
APP_SSO_O365_REQUIRE_ROLE_CLAIM=true
APP_SSO_O365_ALLOW_DEFAULT_ROLE_FALLBACK=false
APP_SSO_O365_DENY_IF_UNMAPPED_ROLES=true
APP_SSO_O365_VERBOSE_USER_ERRORS=true
