{% set key = iconKey|default('file') %}
<span class="source-icon-badge" title="{{ label|default('Icône source') }}">
    {% if key == 'layers' %}
        <svg class="source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4L3 9l9 5 9-5-9-5zM3 14l9 5 9-5M3 19l9 5 9-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif key == 'database' %}
        <svg class="source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3" stroke="currentColor" stroke-width="1.8"/><path d="M4 5v10c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 10c0 1.7 3.6 3 8 3s8-1.3 8-3" stroke="currentColor" stroke-width="1.8"/></svg>
    {% elseif key == 'map' %}
        <svg class="source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6.5L8.5 4l7 2.5L21 4v13.5l-5.5 2.5-7-2.5L3 20V6.5zM8.5 4v13.5M15.5 6.5V20" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif key == 'satellite' %}
        <svg class="source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 10l8-8 4 4-8 8-4-4zM4 12l3 3M10 18l3 3M14 10l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif key == 'file-json' %}
        <svg class="source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6zM14 3v6h6M9.5 13.5l-1.5 1.5 1.5 1.5M14.5 13.5l1.5 1.5-1.5 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% else %}
        <svg class="source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6zM14 3v6h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% endif %}
    <span class="source-icon-badge__label">{{ label|default(key|replace({'-': ' '})|title) }}</span>
</span>
