<p class="result-count">
    {{ catalog.total }} ressource{{ catalog.total > 1 ? 's' : '' }} trouvée{{ catalog.total > 1 ? 's' : '' }}
    ({{ catalog.typeCounters.static }} cartothèque / {{ catalog.typeCounters.interactive }} interactives)
    {% if catalog.totalPages > 1 %}
        - page {{ catalog.page }} / {{ catalog.totalPages }}
    {% endif %}
</p>

{% if catalog.items is empty %}
    <div class="empty-state data-state" role="status" aria-live="polite">
        <h2>Aucun résultat</h2>
        <p>Aucune ressource ne correspond aux critères sélectionnés.</p>
        <p class="data-state__actions">
            <a class="btn btn-outline" href="{{ path('app_data_catalog') }}">Réinitialiser les filtres</a>
        </p>
    </div>
{% else %}
    <div class="grid grid-3">
        {% for item in catalog.items %}
            {% set entryType = item.type %}
            {% set entry = item.entity %}
            {% if entryType == 'interactive' %}
                <article class="card card--interactive card--catalog-item">
                    <p class="card__meta">
                        <span class="badge badge--theme">Carte interactive</span>
                        <span class="badge badge--neutral">{{ entry.publishedAt ? entry.publishedAt|date('d/m/Y') : 'Brouillon' }}</span>
                    </p>
                    <h3 class="card__title"><a href="{{ path('app_interactive_map_show', { slug: entry.slug }) }}">{{ entry.title }}</a></h3>
                    <p class="card__lead">{{ entry.summary ?: 'Visualisation cartographique interactive.' }}</p>
                    <div class="dataset-meta">
                        <span class="dataset-meta__item">{{ entry.layers|length }} couche(s)</span>
                        <span class="dataset-meta__item">Web-SIG</span>
                    </div>
                    <p class="card__link"><a href="{{ path('app_interactive_map_show', { slug: entry.slug }) }}"><span>Ouvrir la carte</span></a></p>
                </article>
            {% else %}
                <article class="card card--dataset card--catalog-item">
                    <p class="card__meta">
                        <span class="badge badge--theme">Donnée cartothèque</span>
                        {% if entry.theme %}<span class="badge badge--neutral">{{ entry.theme }}</span>{% endif %}
                    </p>
                    <h3 class="card__title"><a href="{{ path('app_static_map_show', { slug: entry.slug }) }}">{{ entry.title }}</a></h3>
                    <p class="card__lead">{{ entry.summary ?: (entry.description and entry.description|length > 130 ? entry.description|slice(0, 130) ~ '...' : (entry.description ?: 'Description non renseignée.')) }}</p>
                    <div class="dataset-meta">
                        <span class="dataset-meta__item">{{ entry.assets|length }} support(s)</span>
                        <span class="dataset-meta__item">{{ entry.datasetResources|length }} dataset(s)</span>
                    </div>
                    <p class="card__link"><a href="{{ path('app_static_map_show', { slug: entry.slug }) }}"><span>Consulter la fiche</span></a></p>
                </article>
            {% endif %}
        {% endfor %}
    </div>

    {% if catalog.totalPages > 1 %}
        <nav class="pagination" aria-label="Pagination du catalogue">
            {% for p in 1..catalog.totalPages %}
                {% if p == catalog.page %}
                    <span class="is-current" aria-current="page">{{ p }}</span>
                {% else %}
                    <a data-page-link href="{{ path('app_data_catalog', app.request.query.all|merge({ page: p })) }}">{{ p }}</a>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}
{% endif %}
