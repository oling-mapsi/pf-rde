{% if catalog.items is empty %}
    <div class="empty-state data-state" role="status" aria-live="polite">
        <h2>Aucun résultat</h2>
        <p>Aucune ressource ne correspond aux critères sélectionnés.</p>
        <p class="data-state__actions">
            <a class="btn btn-outline" href="{{ path('app_data_catalog') }}">Réinitialiser les filtres</a>
        </p>
    </div>
{% else %}
    <div class="grid grid-3">
        {% for item in catalog.items %}
            {% set entryType = item.type %}
            {% set entryTypeLabel = catalog.typeLabels[entryType] ?? 'Source de données' %}
            {% set entry = item.entity %}
            {% set entryUrl = path('app_data_source_show', { slug: entry.slug }) %}
            {% set entryCtaLabel = 'Consulter la fiche ressource' %}
            {% set thumbnailSrc = entry.thumbnailPath %}
            {% if thumbnailSrc and not (thumbnailSrc starts with 'http://' or thumbnailSrc starts with 'https://' or thumbnailSrc starts with '/') %}
                {% set thumbnailSrc = '/uploads/data-sources/' ~ thumbnailSrc %}
            {% endif %}
            <article class="card card--dataset card--catalog-item">
                {% if thumbnailSrc %}
                    <img class="card__img" src="{{ thumbnailSrc }}" alt="Illustration {{ entry.title }}">
                {% endif %}
                <p class="card__meta">
                    <span class="badge badge--theme">{{ entryTypeLabel }}</span>
                    {% if entry.iconKey %}
                        {% include 'public/catalog/_source_icon.html.twig' with { iconKey: entry.iconKey, label: entryTypeLabel } only %}
                    {% endif %}
                    {% for category in entry.categories|slice(0, 2) %}
                        <span class="badge badge--neutral">{{ category.name }}</span>
                    {% endfor %}
                    {% if entry.theme %}<span class="badge badge--neutral">{{ entry.theme }}</span>{% endif %}
                </p>
                <h3 class="card__title"><a href="{{ entryUrl }}">{{ entry.title }}</a></h3>
                <p class="card__lead">{{ entry.summary ?: (entry.description and entry.description|length > 130 ? entry.description|slice(0, 130) ~ '...' : (entry.description ?: 'Description non renseignée.')) }}</p>
                <div class="dataset-meta">
                    <span class="dataset-meta__item">{{ entry.format ?: entryTypeLabel }}</span>
                    {% if entry.license %}<span class="dataset-meta__item">{{ entry.license }}</span>{% endif %}
                </div>
                <p class="card__link"><a href="{{ entryUrl }}"><span>{{ entryCtaLabel }}</span></a></p>
            </article>
        {% endfor %}
    </div>

    {% if catalog.totalPages > 1 %}
        <nav class="pagination" aria-label="Pagination du catalogue">
            {% for p in 1..catalog.totalPages %}
                {% if p == catalog.page %}
                    <span class="is-current" aria-current="page">{{ p }}</span>
                {% else %}
                    <a data-page-link href="{{ path('app_data_catalog', app.request.query.all|merge({ page: p })) }}">{{ p }}</a>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}
{% endif %}
