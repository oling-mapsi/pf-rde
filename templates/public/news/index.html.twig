{% extends 'base.html.twig' %}
{% set breadcrumbHomePath = path('app_home') %}
{% set breadcrumbHomeLabel = app.user ? 'Extranet' : 'Accueil' %}

{% block title %}Actualités{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ breadcrumbHomePath }}">{{ breadcrumbHomeLabel }}</a></li>
                    <li aria-current="page">Actualités</li>
                </ol>
            </nav>

            <header class="page-header">
                <h1 class="page-header__title">Actualités et communiqués</h1>
                <p class="page-header__lead">Informations officielles sur les services, publications et évolutions du portail SIG.</p>
            </header>

            {% if news is empty %}
                <div class="empty-state">
                    <h2>Aucune actualité publiée</h2>
                    <p>Les prochaines communications seront publiées dans cette rubrique.</p>
                </div>
            {% else %}
                <div class="grid grid-2 news-index-grid">
                    {% for article in news %}
                        {% set articleImage = newsPreviewImages[article.slug] ?? null %}
                        {% set articleImage = articleImage ? (articleImage starts with '/' or articleImage starts with 'http://' or articleImage starts with 'https://' ? articleImage : asset(articleImage)) : null %}
                        <article class="card news-index-card{{ articleImage ? ' news-index-card--with-image' : '' }}">
                            {% if articleImage %}
                                <a class="news-index-card__media" href="{{ path('app_content_news_show', { slug: article.slug }) }}" aria-hidden="true" tabindex="-1">
                                    <img src="{{ articleImage }}" alt="" class="news-index-card__image">
                                </a>
                            {% endif %}
                            <div class="news-index-card__body">
                            <p class="card__meta">
                                <span class="badge badge--neutral">{{ article.publishedAt ? article.publishedAt|date('d/m/Y') : 'Brouillon' }}</span>
                                <span>Communication institutionnelle</span>
                            </p>
                            <h2 class="card__title"><a href="{{ path('app_content_news_show', { slug: article.slug }) }}">{{ article.title }}</a></h2>
                            <p class="card__lead">{{ article.summary ?: (article.body|length > 170 ? article.body|slice(0, 170) ~ '...' : article.body) }}</p>
                            <p class="card__link"><a href="{{ path('app_content_news_show', { slug: article.slug }) }}"><span>Lire l'actualité</span></a></p>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
