{% extends 'base.html.twig' %}

{% block title %}Routes de Guadeloupe - Portail SIG public{% endblock %}

{% block body_class %}home-page rdg-home{% endblock %}

{% block body %}
    <div class="home-hero-kpis-shell">
        <section
            class="home-banner hero hero--standard home-banner--institutional"
            aria-labelledby="home-title"
            {% if homepageHero.styles is not empty %}
                style="{% for name, value in homepageHero.styles %}{{ name }}: {{ value }}; {% endfor %}"
            {% endif %}
        >
            <div class="home-feder-badge" aria-label="Opération cofinancée par l'Union européenne via le FEDER">
                <img src="{{ asset('images/logo-feder-gp-clean.png') }}" alt="L'Europe s'engage en Guadeloupe - cofinancé par l'Union européenne">
                <p class="visually-hidden">Cet outil s’inscrit dans une opération de transformation numérique du Système d’Information Géographique Routier cofinancée par l’Union européenne via le FEDER.</p>
            </div>
            <div class="container hero__content">
                <div class="hero__intro">
                    <h1 id="home-title" class="home-hero-title">
                        {% for line in homepageHero.titleLines %}
                            <span class="hero-title-line">{{ line }}</span>
                        {% endfor %}
                    </h1>
                    <p class="hero_baseline home-hero-baseline">
                        {% for line in homepageHero.baselineLines %}
                            <span class="hero-baseline-line">{{ line }}</span>
                        {% endfor %}
                    </p>
                </div>
                <section class="home-hero-search" aria-label="Recherche principale">
                    <form class="search-bar search-bar--hero-floating" role="search" action="{{ path('app_data_catalog') }}" method="get" aria-label="Recherche principale">
                        <label class="visually-hidden" for="home-search-input">Recherche dans la cartothèque</label>
                        <input id="home-search-input" class="search-bar__input" type="search" name="q" placeholder="{{ homepageHero.searchPlaceholder }}" aria-label="Recherche dans la cartothèque">
                        <button class="search-bar__icon-submit" type="submit" aria-label="Lancer la recherche">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2"/>
                                <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </form>

                    {% if homepageHero.primaryCtaLabel and homepageHero.primaryCtaUrl %}
                        <a class="home-hero-primary-cta" href="{{ homepageHero.primaryCtaUrl }}">
                            {{ homepageHero.primaryCtaLabel }}
                        </a>
                    {% endif %}
                </section>

                {% if homeHeroThemes is not empty %}
                    <nav class="home-hero-themes" aria-label="Thématiques du catalogue">
                        {% for theme in homeHeroThemes %}
                            {% set accent = theme.accent|default(cycle(['orange', 'blue', 'yellow', 'green'], loop.index0)) %}
                            {% set customColor = theme.color|default(null) %}
                            <a
                                class="home-hero-theme home-hero-theme--{{ accent }} {{ customColor ? 'home-hero-theme--custom' : '' }}"
                                href="{{ theme.url }}"
                                aria-label="{{ theme.label|default(theme.title) }}"
                                {% if customColor %}style="--home-hero-theme-color: {{ customColor }};"{% endif %}
                            >
                                <span class="home-hero-theme__icon {{ customColor ? 'is-custom' : 'is-' ~ accent }}" aria-hidden="true">
                                    {% include 'public/home/_quick_icon.html.twig' with { icon: theme.icon|default('map') } only %}
                                </span>
                                <span class="home-hero-theme__label">{{ theme.title }}</span>
                            </a>
                        {% endfor %}
                    </nav>
                {% endif %}
            </div>
        </section>
    </div>

    {% for section in homepageSections %}
        {% include 'public/home/_section.html.twig' with { section: section } only %}
    {% endfor %}
{% endblock %}
