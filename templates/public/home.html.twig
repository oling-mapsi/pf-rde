{% extends 'base.html.twig' %}

{% block title %}Routes de Guadeloupe - Portail SIG public{% endblock %}

{% block body_class %}home-page rdg-home{% endblock %}

{% block body %}
    <div class="home-hero-kpis-shell">
        <section class="home-banner hero hero--standard home-banner--institutional" aria-labelledby="home-title">
            <div class="container container--content hero__content">
                <div class="hero__intro">
                    <h1 id="home-title" style="color: #FC5000 !important;">
                        {% for line in homepageHero.titleLines %}
                            <span class="hero-title-line" style="color: #FC5000 !important;">{{ line }}</span>
                        {% endfor %}
                    </h1>
                    <p class="hero_baseline">
                        {% for line in homepageHero.baselineLines %}
                            <span class="hero-baseline-line">{{ line }}</span>
                        {% endfor %}
                    </p>
                    <div class="home-feder-badge" aria-label="Information de cofinancement européen">
                        <img src="{{ asset('images/bloc-marque-feder.png') }}" alt="L'Europe s'engage en Guadeloupe - cofinancé par l'Union européenne">
                        <p>Cet outil s’inscrit dans une opération de transformation numérique du Système d’Information Géographique Routier cofinancée par l’Union européenne via le FEDER.</p>
                    </div>
                </div>
                <section class="home-hero-search" aria-label="Recherche principale">
                    <p class="home-kpis__search-subtitle">
                        {{ homepageHero.searchIntro }}
                    </p>

                    <form class="search-bar search-bar--hero-floating" role="search" action="{{ path('app_data_catalog') }}" method="get" aria-label="Recherche principale">
                        <label class="visually-hidden" for="home-search-input">Recherche dans la cartothèque</label>
                        <input id="home-search-input" class="search-bar__input" type="search" name="q" placeholder="{{ homepageHero.searchPlaceholder }}" aria-label="Recherche dans la cartothèque">
                        <button class="search-bar__icon-submit" type="submit" aria-label="Lancer la recherche">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="11" cy="11" r="6.5" stroke="#4f5460" stroke-width="2"/>
                                <path d="M16 16l4.5 4.5" stroke="#4f5460" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </form>
                </section>
            </div>
        </section>

        {% for section in homepageSections %}
            {% if section.backgroundStyle == 'kpi' %}
                {% include 'public/home/_section.html.twig' with { section: section } only %}
            {% endif %}
        {% endfor %}
    </div>

    {% for section in homepageSections %}
        {% if section.backgroundStyle != 'kpi' %}
            {% include 'public/home/_section.html.twig' with { section: section } only %}
        {% endif %}
    {% endfor %}
{% endblock %}
