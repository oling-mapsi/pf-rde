{% extends 'base.html.twig' %}

{% block title %}{{ map.title }}{% endblock %}

{% block body %}
    <section class="page-shell page-shell--catalog">
        <div class="container">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_data_catalog', { type: ['static'] }) }}">Données et cartes</a></li>
                    <li aria-current="page">{{ map.title }}</li>
                </ol>
            </nav>

            <header class="page-header">
                <p class="page-header__eyebrow">
                    <span class="section-icon section-icon--orange" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M3 7.5l5-2.5 8 3 5-2.5v11l-5 2.5-8-3-5 2.5v-11zM8 5v11M16 8v11" stroke="currentColor" stroke-width="1.8"/></svg>
                    </span>
                    <span>Fiche cartographique</span>
                </p>
                <p class="card__meta">
                    <span class="badge badge--theme">{{ map.theme ?: 'Sans thème' }}</span>
                    {% if map.documentDate %}<span class="badge badge--neutral">Date documentaire: {{ map.documentDate|date('d/m/Y') }}</span>{% endif %}
                </p>
                <h1 class="page-header__title">{{ map.title }}</h1>
                <p class="page-header__lead">{{ map.summary ?: 'Ressource cartographique de référence pour le territoire.' }}</p>
            </header>

            <section class="resource-layout">
                <article class="card">
                    <h2 class="h4 heading-inline">
                        <span class="section-icon section-icon--blue" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M6 3h9l5 5v13H6V3zm9 0v5h5" stroke="currentColor" stroke-width="1.8"/></svg>
                        </span>
                        <span>Description</span>
                    </h2>
                    <p>{{ map.description ?: 'Description en cours de redaction.' }}</p>

                    {% if map.metadataRecord %}
                        <h2 class="h4 mt-4">Métadonnées</h2>
                        <dl class="meta-list">
                            <div>
                                <dt>Identifiant</dt>
                                <dd>{{ map.metadataRecord.identifier }}</dd>
                            </div>
                            <div>
                                <dt>Titre métadonnée</dt>
                                <dd>{{ map.metadataRecord.title }}</dd>
                            </div>
                            <div>
                                <dt>Dernière synchronisation</dt>
                                <dd>{{ map.metadataRecord.lastSyncedAt ? map.metadataRecord.lastSyncedAt|date('d/m/Y H:i') : 'Non renseigné' }}</dd>
                            </div>
                        </dl>
                    {% endif %}
                </article>

                <aside class="resource-side">
                    <article class="card">
                        <h2 class="h5 heading-inline">
                            <span class="section-icon section-icon--orange" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v10m0 0l4-4m-4 4l-4-4M5 17v2h14v-2" stroke="currentColor" stroke-width="1.8"/></svg>
                            </span>
                            <span>Téléchargements</span>
                        </h2>
                        {% if map.assets is empty %}
                            <div class="empty-state">
                                <p>Aucun support disponible.</p>
                            </div>
                        {% else %}
                            <ul class="download-list">
                                {% for asset in map.assets %}
                                    <li>
                                        <span>
                                            <strong>{{ asset.label }}</strong><br>
                                            <small>{{ asset.assetType|upper }}{% if asset.fileSize %} - {{ (asset.fileSize / 1024)|round }} Ko{% endif %}</small>
                                        </span>
                                        <a class="btn btn-outline" href="{{ asset.filePath }}">Télécharger</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </article>

                    <article class="card">
                        <h2 class="h5 heading-inline">
                            <span class="section-icon section-icon--green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16M8 5v14M16 5v14" stroke="currentColor" stroke-width="1.8"/></svg>
                            </span>
                            <span>Jeux de données associés</span>
                        </h2>
                        {% if map.datasetResources is empty %}
                            <p>Aucun dataset associé.</p>
                        {% else %}
                            <ul class="download-list">
                                {% for dataset in map.datasetResources %}
                                    <li>
                                        <span>
                                            <strong>{{ dataset.label }}</strong><br>
                                            <small>{{ dataset.format|upper }}{% if dataset.license %} - {{ dataset.license }}{% endif %}</small>
                                        </span>
                                        {% if dataset.external and dataset.url %}
                                            <a class="btn btn-outline" href="{{ dataset.url }}" target="_blank" rel="noopener noreferrer">Ouvrir</a>
                                        {% elseif dataset.filePath %}
                                            <a class="btn btn-outline" href="{{ dataset.filePath }}">Télécharger</a>
                                        {% else %}
                                            <span class="text-muted">Lien non renseigné</span>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </article>
                </aside>
            </section>
        </div>
    </section>
{% endblock %}
