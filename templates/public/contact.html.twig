{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li aria-current="page">Contact</li>
                </ol>
            </nav>

            <header class="page-header">
                <h1 class="page-header__title">Contacter le service SIG</h1>
                <p class="page-header__lead">Pour toute demande générale, utilisez ce formulaire. Les demandes agents passent par l’espace sécurisé.</p>
            </header>

            <section class="card form-panel" data-controller="async-form">
                <div data-async-form-target="feedback"></div>
                {{ form_start(form, { attr: { 'data-action': 'submit->async-form#submit' } }) }}
                    <div class="request-form-layout">
                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Vos coordonnées</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.fullName) }}</div>
                                <div>{{ form_row(form.email) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Votre message</h2>
                            </div>
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.subject) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.message) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section request-form-section--consent">
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.privacyConsent) }}</div>
                            </div>
                        </section>
                    </div>
                    <button type="submit" class="btn btn-primary">Envoyer le message</button>
                {{ form_end(form) }}
            </section>
        </div>
    </section>
{% endblock %}
