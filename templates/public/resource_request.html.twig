{% extends 'base.html.twig' %}

{% block title %}Demande de carte ou de données{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li aria-current="page">Demande de carte ou de données</li>
                </ol>
            </nav>

            <header class="page-header">
                <p class="page-header__eyebrow">Demandes externes</p>
                <h1 class="page-header__title">Demander une carte ou des données</h1>
                <p class="page-header__lead">Ce formulaire permet aux usagers et professionnels de transmettre un besoin précis. Les professionnels disposant déjà d’un compte peuvent aussi déposer leur demande depuis l’espace privé.</p>
            </header>

            <section class="card request-intro-card">
                <div>
                    <h2 class="h4">Professionnels</h2>
                    <p>Si vous êtes un professionnel régulier, l’usage recommandé est la demande depuis votre espace privé pour suivre plus facilement vos échanges.</p>
                </div>
                <div class="request-intro-card__actions">
                    <a class="btn btn-primary" href="{{ path('app_login') }}">Connexion</a>
                    <a class="btn btn-outline" href="{{ path('app_register_external') }}">Créer un compte professionnel</a>
                </div>
            </section>

            <section class="card form-panel request-form-shell" data-controller="request-submission">
                {{ form_start(form) }}
                    <div class="request-form-layout">
                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Identité</h2>
                                <p class="request-form-section__intro">Les coordonnées de contact servent au suivi de la demande.</p>
                            </div>
                            <div class="request-form-grid">
                                {% if form.requesterType is defined %}
                                    <div class="request-form-grid__full">{{ form_row(form.requesterType) }}</div>
                                {% endif %}

                                <div>{{ form_row(form.lastName) }}</div>
                                <div>{{ form_row(form.firstName) }}</div>

                                <div>{{ form_row(form.email) }}</div>
                                <div>{{ form_row(form.emailConfirmation) }}</div>

                                <div>{{ form_row(form.phoneNumber) }}</div>
                                <div>{{ form_row(form.postalCode) }}</div>

                                <div class="request-form-grid__full">{{ form_row(form.city) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section" data-request-submission-target="professionalSection" hidden>
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Structure</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.organizationName) }}</div>
                                <div>{{ form_row(form.companySiret) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Besoin</h2>
                            </div>
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.subject) }}</div>
                                <div>{{ form_row(form.requestKinds) }}</div>
                                <div>{{ form_row(form.networkTypes) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.message) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.additionalInformation) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section" data-request-submission-target="deliverySection" hidden>
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Livrable souhaité</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.dataFormats) }}</div>
                                <div>{{ form_row(form.projectionSystem) }}</div>
                                <div>{{ form_row(form.mapFormats) }}</div>
                                <div>{{ form_row(form.mapScale) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section request-form-section--consent">
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.privacyConsent) }}</div>
                            </div>
                        </section>
                    </div>
                    <div class="request-form-shell__actions">
                        <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </section>
{% endblock %}
