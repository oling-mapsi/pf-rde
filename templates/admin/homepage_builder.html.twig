{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Builder de la page d’accueil{% endblock %}

{% block main %}
    <style>
        .homepage-builder {
            display: grid;
            gap: 1.25rem;
        }

        .homepage-builder__panel {
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1rem;
        }

        .homepage-builder__grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .homepage-builder__field {
            display: grid;
            gap: .35rem;
        }

        .homepage-builder__field--wide {
            grid-column: 1 / -1;
        }

        .homepage-builder__field label {
            font-weight: 700;
        }

        .homepage-builder__field input,
        .homepage-builder__field textarea,
        .homepage-builder__field select {
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: .65rem .75rem;
            width: 100%;
        }

        .homepage-builder__quick-actions {
            display: grid;
            gap: .85rem;
        }

        .homepage-builder__quick-row {
            display: grid;
            gap: .75rem;
            grid-template-columns: 1fr 1.25fr 1fr 1.1fr .8fr;
            align-items: end;
            padding: .85rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--body-bg);
        }

        .homepage-builder__icon-select {
            position: relative;
        }

        .homepage-builder__icon-select-button,
        .homepage-builder__icon-select-option {
            align-items: center;
            display: flex;
            gap: .55rem;
            width: 100%;
            min-height: 2.65rem;
            padding: .55rem .65rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-color);
            background: var(--body-bg);
            text-align: left;
        }

        .homepage-builder__icon-select-button {
            justify-content: space-between;
            cursor: pointer;
        }

        .homepage-builder__icon-select-current,
        .homepage-builder__icon-select-option-content {
            align-items: center;
            display: flex;
            min-width: 0;
            gap: .55rem;
        }

        .homepage-builder__icon-select-current svg,
        .homepage-builder__icon-select-option svg {
            width: 1.15rem;
            height: 1.15rem;
            flex: 0 0 auto;
        }

        .homepage-builder__icon-select-label,
        .homepage-builder__icon-select-option span {
            overflow: hidden;
            font-size: .9rem;
            font-weight: 700;
            line-height: 1.15;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .homepage-builder__icon-select-chevron {
            color: var(--text-muted);
            flex: 0 0 auto;
        }

        .homepage-builder__icon-select-menu {
            position: absolute;
            z-index: 20;
            inset-inline: 0;
            top: calc(100% + .35rem);
            display: grid;
            gap: .25rem;
            max-height: 20rem;
            padding: .35rem;
            overflow: auto;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--body-bg);
            box-shadow: 0 .8rem 2rem rgba(var(--rdg-ink-rgb), .18);
        }

        .homepage-builder__icon-select-menu[hidden] {
            display: none;
        }

        .homepage-builder__icon-select-option {
            border-color: transparent;
            cursor: pointer;
        }

        .homepage-builder__icon-select-option:hover,
        .homepage-builder__icon-select-option:focus-visible {
            color: var(--color-brand-primary);
            background: rgba(var(--rdg-orange-road-rgb), .08);
        }

        .homepage-builder__icon-select-option.is-selected {
            color: var(--color-brand-primary);
            border-color: rgba(var(--rdg-orange-road-rgb), .35);
            background: rgba(var(--rdg-orange-road-rgb), .1);
        }

        .homepage-builder__sections {
            display: grid;
            gap: .65rem;
            margin: 0;
            padding: 0;
        }

        .homepage-builder__section {
            align-items: center;
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            cursor: grab;
            display: grid;
            gap: .85rem;
            grid-template-columns: auto 1fr auto;
            list-style: none;
            padding: .85rem;
        }

        .homepage-builder__section.is-dragging {
            opacity: .55;
        }

        .homepage-builder__handle {
            color: var(--text-muted);
            font-size: 1.2rem;
            line-height: 1;
        }

        .homepage-builder__section-title {
            font-weight: 800;
            margin: 0;
        }

        .homepage-builder__section-meta {
            color: var(--text-muted);
            font-size: .875rem;
            margin: .15rem 0 0;
        }

        .homepage-builder__status {
            min-height: 1.4rem;
        }

        .homepage-builder__cards-section {
            display: grid;
            gap: .65rem;
            padding: .85rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--body-bg);
        }

        .homepage-builder__cards-section-title {
            margin: 0;
            font-weight: 800;
        }

        .homepage-builder__cards-grid {
            display: grid;
            gap: .75rem;
        }

        .homepage-builder__card-row {
            display: grid;
            gap: .7rem;
            grid-template-columns: 1.05fr 1.5fr 1.2fr 1.2fr 1fr;
            align-items: end;
            padding: .7rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: color-mix(in srgb, var(--body-bg) 92%, var(--rdg-ink) 8%);
        }

        @media (max-width: 760px) {
            .homepage-builder__grid,
            .homepage-builder__section,
            .homepage-builder__quick-row,
            .homepage-builder__card-row {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="homepage-builder">
        <section class="homepage-builder__panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Héros</h2>
                    <p class="text-muted mb-0">Texte principal, recherche et appel à l’action de la première zone visible.</p>
                </div>
                <a class="btn btn-secondary" href="{{ heroCrudUrl }}">Mode CRUD complet</a>
            </div>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('homepage_builder') }}">
                <div class="homepage-builder__grid">
                    <div class="homepage-builder__field">
                        <label for="homepage-name">Nom interne</label>
                        <input id="homepage-name" name="name" value="{{ homepage.name }}">
                    </div>
                    <div class="homepage-builder__field homepage-builder__field--wide">
                        <label for="homepage-title">Titre</label>
                        <input id="homepage-title" name="heroTitle" value="{{ homepage.heroTitle }}" required>
                    </div>
                    <div class="homepage-builder__field homepage-builder__field--wide">
                        <label for="homepage-baseline">Introduction</label>
                        <textarea id="homepage-baseline" name="heroBaseline" rows="3">{{ homepage.heroBaseline }}</textarea>
                    </div>
                    <div class="homepage-builder__field homepage-builder__field--wide">
                        <label for="homepage-background-image">Image de fond du héros</label>
                        <input
                            id="homepage-background-image"
                            name="heroBackgroundImagePath"
                            value="{{ homepage.heroBackgroundImagePath }}"
                            placeholder="/uploads/content/... ou https://..."
                        >
                    </div>
                    <div class="homepage-builder__field homepage-builder__field--wide">
                        <label for="homepage-search-placeholder">Placeholder de recherche</label>
                        <input id="homepage-search-placeholder" name="searchPlaceholder" value="{{ homepage.searchPlaceholder }}">
                    </div>
                    <div class="homepage-builder__field">
                        <label for="homepage-cta-label">Bouton principal</label>
                        <input id="homepage-cta-label" name="primaryCtaLabel" value="{{ homepage.primaryCtaLabel }}">
                    </div>
                    <div class="homepage-builder__field">
                        <label for="homepage-cta-url">URL du bouton</label>
                        <input id="homepage-cta-url" name="primaryCtaUrl" value="{{ homepage.primaryCtaUrl }}">
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary" type="submit">Enregistrer le héros</button>
                </div>
            </form>
        </section>

        <section class="homepage-builder__panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Images des cartes (sections)</h2>
                    <p class="text-muted mb-0">Modifiez ici les visuels et textes des cartes, dont les entrées du bloc “Solliciter”, sans passer par le JSON brut.</p>
                </div>
            </div>

            <form method="post">
                <input type="hidden" name="_form" value="section_cards">
                <input type="hidden" name="_token" value="{{ csrf_token('homepage_section_cards') }}">
                <div class="homepage-builder__quick-actions">
                    {% for section in editableCardsSections %}
                        {% set sectionItems = section.itemsConfigArray %}
                        <article class="homepage-builder__cards-section">
                            <p class="homepage-builder__cards-section-title">{{ section.title ?: section.name }}</p>
                            <p class="homepage-builder__section-meta mb-0">{{ section.type }} · {{ section.backgroundStyle }}</p>

                            <div class="homepage-builder__field">
                                <label for="section-image-{{ section.id }}">Image de section (optionnelle)</label>
                                <input id="section-image-{{ section.id }}" name="sections[{{ section.id }}][imagePath]" value="{{ section.imagePath|default('') }}" placeholder="/images/... ou https://...">
                            </div>

                            <div class="homepage-builder__cards-grid">
                                {% for item in sectionItems %}
                                    <div class="homepage-builder__card-row">
                                        <div class="homepage-builder__field">
                                            <label for="section-{{ section.id }}-title-{{ loop.index0 }}">Titre</label>
                                            <input id="section-{{ section.id }}-title-{{ loop.index0 }}" name="sections[{{ section.id }}][items][{{ loop.index0 }}][title]" value="{{ item.title|default('') }}">
                                        </div>
                                        <div class="homepage-builder__field">
                                            <label for="section-{{ section.id }}-text-{{ loop.index0 }}">Texte</label>
                                            <input id="section-{{ section.id }}-text-{{ loop.index0 }}" name="sections[{{ section.id }}][items][{{ loop.index0 }}][text]" value="{{ item.text|default('') }}">
                                        </div>
                                        <div class="homepage-builder__field">
                                            <label for="section-{{ section.id }}-image-{{ loop.index0 }}">Image</label>
                                            <input id="section-{{ section.id }}-image-{{ loop.index0 }}" name="sections[{{ section.id }}][items][{{ loop.index0 }}][imagePath]" value="{{ item.imagePath|default('') }}" placeholder="/images/... ou https://...">
                                        </div>
                                        <div class="homepage-builder__field">
                                            <label for="section-{{ section.id }}-url-{{ loop.index0 }}">Lien</label>
                                            <input id="section-{{ section.id }}-url-{{ loop.index0 }}" name="sections[{{ section.id }}][items][{{ loop.index0 }}][url]" value="{{ item.url|default('') }}">
                                        </div>
                                        <div class="homepage-builder__field">
                                            <label for="section-{{ section.id }}-label-{{ loop.index0 }}">Libellé CTA</label>
                                            <input id="section-{{ section.id }}-label-{{ loop.index0 }}" name="sections[{{ section.id }}][items][{{ loop.index0 }}][label]" value="{{ item.label|default('') }}">
                                        </div>
                                    </div>
                                {% else %}
                                    <p class="text-muted mb-0">Aucune carte manuelle configurée pour cette section.</p>
                                {% endfor %}
                            </div>
                        </article>
                    {% else %}
                        <p class="text-muted mb-0">Aucune section de cartes éditable trouvée.</p>
                    {% endfor %}
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary" type="submit">Enregistrer les sections</button>
                </div>
            </form>
        </section>

        <section class="homepage-builder__panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Thèmes cartothèque mis en avant (héros)</h2>
                    <p class="text-muted mb-0">Tous les thèmes cochés “mise en avant” apparaissent automatiquement sous le héros.</p>
                </div>
                <a class="btn btn-primary" href="{{ ea_url().unsetAll().setController(themeCrudController).setAction('index') }}">Gérer les thèmes</a>
            </div>

            <div class="homepage-builder__quick-actions">
                {% for theme in featuredThemes %}
                    <div class="homepage-builder__quick-row">
                        <div class="homepage-builder__field">
                            <label>Nom</label>
                            <input value="{{ theme.label }}" readonly>
                        </div>
                        <div class="homepage-builder__field">
                            <label>Filtre appliqué</label>
                            <input value="theme[0]={{ theme.label }}" readonly>
                        </div>
                        <div class="homepage-builder__field">
                            <label>Icône</label>
                            <input value="{{ theme.iconKey }}" readonly>
                        </div>
                        <div class="homepage-builder__field">
                            <label>Couleur</label>
                            <input value="{{ theme.colorHex }}" readonly>
                        </div>
                        <div class="homepage-builder__field">
                            <label>Position</label>
                            <input value="{{ theme.position }}" readonly>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">Aucun thème publié n’est mis en avant. Activez “Mise en avant sur la home” dans le CRUD Thèmes.</p>
                {% endfor %}
                <div class="mt-3">
                    <a class="btn btn-secondary" href="{{ ea_url().unsetAll().setController(themeCrudController).setAction('new') }}">Créer un thème</a>
                </div>
            </div>
        </section>

        <section class="homepage-builder__panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Sections</h2>
                    <p class="text-muted mb-0">Glissez les blocs pour modifier l’ordre d’affichage, puis enregistrez.</p>
                </div>
                <a class="btn btn-primary" href="{{ newSectionUrl }}">Créer une section</a>
            </div>

            <div
                data-homepage-builder
                data-reorder-url="{{ reorderUrl }}"
                data-token="{{ csrf_token('homepage_reorder') }}"
            >
                <ul class="homepage-builder__sections" data-section-list>
                    {% for section in sections %}
                        <li class="homepage-builder__section" draggable="true" data-section-id="{{ section.id }}">
                            <span class="homepage-builder__handle" aria-hidden="true">↕</span>
                            <div>
                                <p class="homepage-builder__section-title">{{ section.title ?: section.name }}</p>
                                <p class="homepage-builder__section-meta">
                                    #{{ section.position }} · {{ section.type }} · {{ section.status }}
                                </p>
                            </div>
                            <a class="btn btn-secondary" href="{{ ea_url().unsetAll().setController(sectionCrudController).setAction('edit').setEntityId(section.id) }}">Modifier</a>
                        </li>
                    {% else %}
                        <li class="homepage-builder__section">
                            <div>
                                <p class="homepage-builder__section-title">Aucune section créée</p>
                                <p class="homepage-builder__section-meta">La home utilise encore les sections de secours.</p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                <div class="d-flex align-items-center gap-2 mt-3">
                    <button class="btn btn-primary" type="button" data-save-order {{ sections is empty ? 'disabled' : '' }}>Enregistrer l’ordre</button>
                    <span class="homepage-builder__status text-muted" data-order-status aria-live="polite"></span>
                </div>
            </div>
        </section>
    </div>

    <script>
        (() => {
            const builder = document.querySelector('[data-homepage-builder]');
            if (!builder) {
                return;
            }

            const list = builder.querySelector('[data-section-list]');
            const saveButton = builder.querySelector('[data-save-order]');
            const status = builder.querySelector('[data-order-status]');
            let draggedItem = null;

            const getAfterElement = (container, y) => {
                const items = [...container.querySelectorAll('[data-section-id]:not(.is-dragging)')];

                return items.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;
                    if (offset < 0 && offset > closest.offset) {
                        return { offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
            };

            list.addEventListener('dragstart', (event) => {
                const item = event.target.closest('[data-section-id]');
                if (!item) {
                    return;
                }

                draggedItem = item;
                item.classList.add('is-dragging');
                event.dataTransfer.effectAllowed = 'move';
            });

            list.addEventListener('dragend', () => {
                if (draggedItem) {
                    draggedItem.classList.remove('is-dragging');
                    draggedItem = null;
                    status.textContent = 'Ordre modifié, pensez à enregistrer.';
                }
            });

            list.addEventListener('dragover', (event) => {
                event.preventDefault();
                if (!draggedItem) {
                    return;
                }

                const afterElement = getAfterElement(list, event.clientY);
                if (afterElement === null) {
                    list.appendChild(draggedItem);
                } else {
                    list.insertBefore(draggedItem, afterElement);
                }
            });

            saveButton?.addEventListener('click', async () => {
                const positions = [...list.querySelectorAll('[data-section-id]')].map((item) => item.dataset.sectionId);
                status.textContent = 'Enregistrement...';
                saveButton.disabled = true;

                try {
                    const response = await fetch(builder.dataset.reorderUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ _token: builder.dataset.token, positions }),
                    });

                    if (!response.ok) {
                        throw new Error('Reorder failed');
                    }

                    status.textContent = 'Ordre enregistré.';
                } catch (error) {
                    status.textContent = 'Impossible d’enregistrer l’ordre.';
                } finally {
                    saveButton.disabled = false;
                }
            });
        })();
    </script>
{% endblock %}
