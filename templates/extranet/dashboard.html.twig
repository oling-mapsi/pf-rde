{% extends 'base.html.twig' %}

{% block title %}{{ extranetTitle }}{% endblock %}

{% block body %}
    <section class="page-shell page-shell--agent">
        <div class="container">
            {% include 'extranet/_mini_hero.html.twig' with {
                kicker: '',
                title: extranetTitle,
                lead: isAgentExtranet
                    ? 'Bienvenue dans l’espace extranet agent. Accédez rapidement à vos ressources, favoris et demandes.'
                    : 'Bienvenue dans l’espace extranet professionnel. Accédez rapidement à vos ressources, favoris et demandes.',
                searchInputId: 'extranet-search-input',
                placeholder: 'Rechercher une carte, un fichier, un service WMS/WFS...'
            } only %}

            <div class="extranet-layout">
                <aside class="extranet-layout__sidebar">
                    <section class="extranet-sidebar-actions" aria-label="Actions extranet">
                        <button type="button" class="btn btn-primary js-open-request-modal">Demander une ressource</button>
                        {% if isAgentExtranet %}
                            <a class="btn btn-outline" href="{{ path('agent_request_new') }}">Demande interne SIG</a>
                        {% endif %}
                        {% if not isAgentExtranet %}
                            <a class="btn btn-outline" href="{{ path('app_account_change_password') }}">Changer mon mot de passe</a>
                        {% endif %}
                    </section>
                </aside>

                <div class="extranet-layout__main">
                    <section class="card mt-4">
                        <div class="extranet-section-header">
                            <h2 class="h4 extranet-section-heading">
                                <span>Mes favoris</span>
                                <span class="extranet-count-badge">{{ favorites|length }}</span>
                            </h2>
                            <a class="extranet-section-link" href="{{ path('app_data_catalog') }}">Consulter toutes les données cartes</a>
                        </div>
                        {% if favorites is empty %}
                            <p>Aucun favori pour le moment.</p>
                        {% else %}
                            <div class="favorite-catalog-list" role="list">
                                {% for favorite in favorites %}
                                    <article class="card card--catalog-reference favorite-catalog-card" role="listitem">
                                        <div class="favorite-catalog-card__mini" aria-hidden="true">
                                            {% if favorite.thumbnailUrl %}
                                                <img class="favorite-catalog-card__thumb" src="{{ favorite.thumbnailUrl }}" alt="">
                                            {% else %}
                                                <span class="favorite-catalog-card__thumb-fallback"></span>
                                            {% endif %}
                                            <span class="catalog-card__category-badge">{{ favorite.kindLabel }}</span>
                                        </div>
                                        <div class="catalog-card__body">
                                            <h3 class="card__title">
                                                <a href="{{ favorite.resourceUrl }}">{{ favorite.resourceTitle }}</a>
                                            </h3>
                                            <div class="favorite-catalog-card__actions">
                                                <a class="favorite-catalog-card__link" href="{{ favorite.resourceUrl }}">Consulter</a>
                                                <form method="post" action="{{ path('extranet_favorite_remove', { id: favorite.id }) }}">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('favorite_remove_' ~ favorite.id) }}">
                                                    <button type="submit" class="favorite-action-btn" aria-label="Retirer {{ favorite.resourceTitle }} des favoris" title="Retirer">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                            <path d="M3 6h18M8 6V4h8v2M10 11v6M14 11v6M6 6l1 14a1 1 0 0 0 1 .9h8a1 1 0 0 0 1-.9L18 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                        <span class="visually-hidden">Retirer</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </section>

                    <section class="card mt-4">
                        <h2 class="h4 extranet-section-heading">
                            <span>Historique de mes demandes</span>
                            <span class="extranet-count-badge">{{ resourceRequests|length }}</span>
                        </h2>
                        {% if resourceRequests is empty %}
                            <p>Aucune demande envoyée.</p>
                        {% else %}
                            <div class="table-wrap">
                                <table class="table table--data">
                                    <thead>
                                        <tr>
                                            <th>Objet</th>
                                            <th>Statut</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in resourceRequests %}
                                            <tr>
                                                <td data-label="Objet">{{ item.subject }}</td>
                                                <td data-label="Statut">{{ item.status|replace({'_': ' '})|title }}</td>
                                                <td data-label="Date">{{ item.submittedAt|date('d/m/Y H:i') }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </section>
                </div>
            </div>

            <dialog class="extranet-modal" id="resource-request-modal" aria-labelledby="resource-request-modal-title">
                <div class="extranet-modal__head">
                    <h2 class="h4" id="resource-request-modal-title">Demander une ressource supplémentaire</h2>
                    <button type="button" class="extranet-modal__close js-close-request-modal" aria-label="Fermer">×</button>
                </div>
                <div class="extranet-modal__body form-panel">
                    {{ form_start(requestForm) }}
                        {{ form_row(requestForm.subject) }}
                        {{ form_row(requestForm.message) }}
                        <div class="extranet-modal__actions">
                            <button type="button" class="btn btn-outline js-close-request-modal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                        </div>
                    {{ form_end(requestForm) }}
                </div>
            </dialog>
        </div>
    </section>

    <script>
        (() => {
            const dialog = document.getElementById('resource-request-modal');
            const openButtons = document.querySelectorAll('.js-open-request-modal');
            const closeButtons = document.querySelectorAll('.js-close-request-modal');

            if (!(dialog instanceof HTMLDialogElement)) {
                return;
            }

            const openDialog = () => {
                if (!dialog.open) {
                    dialog.showModal();
                }
            };

            const closeDialog = () => {
                if (dialog.open) {
                    dialog.close();
                }
            };

            openButtons.forEach((button) => {
                button.addEventListener('click', openDialog);
            });

            closeButtons.forEach((button) => {
                button.addEventListener('click', closeDialog);
            });

            dialog.addEventListener('click', (event) => {
                const bounds = dialog.getBoundingClientRect();
                const clickedOutside =
                    event.clientX < bounds.left ||
                    event.clientX > bounds.right ||
                    event.clientY < bounds.top ||
                    event.clientY > bounds.bottom;

                if (clickedOutside) {
                    closeDialog();
                }
            });

            {% if requestForm.vars.submitted and not requestForm.vars.valid %}
            openDialog();
            {% endif %}
        })();
    </script>
{% endblock %}
