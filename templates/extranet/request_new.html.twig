{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande professionnelle{% endblock %}

{% block body %}
    <section class="page-shell page-shell--agent">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('extranet_dashboard') }}">Mon espace</a></li>
                    <li aria-current="page">Nouvelle demande</li>
                </ol>
            </nav>

            <header class="page-header">
                <p class="page-header__eyebrow">Espace professionnel</p>
                <h1 class="page-header__title">Nouvelle demande de carte ou de données</h1>
                <p class="page-header__lead">Les informations de votre compte sont préremplies. Vous pouvez les ajuster pour cette demande si nécessaire.</p>
            </header>

            <section class="card form-panel request-form-shell" data-controller="request-submission">
                <div class="request-form-shell__legal">
                    <p><strong>Traitement :</strong> votre demande sera instruite par l’équipe habilitée de la plateforme.</p>
                    <p><strong>Suivi :</strong> le numéro de demande sera disponible dans votre tableau de bord après soumission.</p>
                </div>

                {{ form_start(form) }}
                    <div class="request-form-layout">
                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Coordonnées</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.lastName) }}</div>
                                <div>{{ form_row(form.firstName) }}</div>
                                <div>{{ form_row(form.email) }}</div>
                                <div>{{ form_row(form.phoneNumber) }}</div>
                                <div>{{ form_row(form.postalCode) }}</div>
                                <div>{{ form_row(form.city) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Entreprise</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.organizationName) }}</div>
                                <div>{{ form_row(form.companySiret) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Demande</h2>
                            </div>
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.subject) }}</div>
                                <div>{{ form_row(form.requestKinds) }}</div>
                                <div>{{ form_row(form.networkTypes) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.message) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.additionalInformation) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Livrable attendu</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.dataFormats) }}</div>
                                <div>{{ form_row(form.projectionSystem) }}</div>
                                <div>{{ form_row(form.mapFormats) }}</div>
                                <div>{{ form_row(form.mapScale) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section request-form-section--consent">
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.privacyConsent) }}</div>
                            </div>
                        </section>
                    </div>
                    <div class="request-form-shell__actions">
                        <button type="submit" class="btn btn-primary">Soumettre la demande</button>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </section>
{% endblock %}
