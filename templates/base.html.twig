<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Routes de Guadeloupe - Portail SIG{% endblock %}</title>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <style>
            #site-main-nav .main-nav__account-menu {
                min-width: 20rem;
                max-width: min(24rem, calc(100vw - 2rem));
                padding: 0.82rem 0.65rem 0.65rem;
                border: 1px solid rgba(16, 16, 16, 0.14);
                border-radius: 0.9rem;
                background: linear-gradient(180deg, rgba(250, 253, 255, 0.98), rgba(255, 255, 255, 0.98));
                box-shadow: 0 20px 42px rgba(16, 16, 16, 0.18);
            }

            #site-main-nav .main-nav__account-summary {
                display: grid;
                grid-template-columns: 2.4rem minmax(0, 1fr);
                align-items: center;
                gap: 0.78rem;
                margin: 0.16rem 0.2rem 0.5rem;
                padding: 0.78rem 0.8rem;
                border: 1px solid rgba(56, 180, 231, 0.28);
                border-radius: 0.78rem;
                background: linear-gradient(120deg, rgba(56, 180, 231, 0.12), rgba(14, 140, 96, 0.08));
            }

            #site-main-nav .main-nav__account-avatar {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 2.3rem;
                height: 2.3rem;
                margin: 0;
                border: 1px solid rgba(255, 255, 255, 0.72);
                border-radius: 999px;
                color: #fff;
                background: linear-gradient(135deg, var(--rdg-brand-secondary), var(--rdg-brand-accent-3));
                box-shadow: 0 6px 16px rgba(16, 16, 16, 0.18);
                font-size: 0.8rem;
                font-weight: 800;
                letter-spacing: 0.05em;
                line-height: 1;
                text-transform: uppercase;
            }

            #site-main-nav .main-nav__account-kicker {
                margin: 0 0 0.12rem;
                color: var(--color-text-muted);
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.03em;
                text-transform: uppercase;
            }

            #site-main-nav .main-nav__account-name {
                margin: 0;
                color: var(--color-text-heading);
                font-size: 0.98rem;
                font-weight: 700;
                line-height: 1.25;
                word-break: break-word;
            }

            #site-main-nav .main-nav__account-type {
                display: inline-flex;
                width: fit-content;
                margin: 0.45rem 0 0;
                padding: 0.2rem 0.55rem;
                border-radius: var(--radius-pill);
                border: 1px solid rgba(56, 180, 231, 0.28);
                color: #0d5f78;
                background: rgba(255, 255, 255, 0.92);
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.02em;
                line-height: 1.25;
                text-transform: uppercase;
            }

            #site-main-nav .main-nav__account-divider {
                display: block;
                height: 1px;
                margin: 0.12rem 0.2rem 0.4rem;
                background: linear-gradient(90deg, rgba(56, 180, 231, 0.45), rgba(16, 16, 16, 0.12) 42%, rgba(16, 16, 16, 0.06));
            }

            #site-main-nav .main-nav__account-actions {
                display: grid;
                gap: 0.18rem;
            }
        </style>
    </head>
    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set isCatalogRoute = currentRoute == 'app_data_catalog' or currentRoute starts with 'app_static_map_' or currentRoute starts with 'app_interactive_map_' %}
    <body class="{% block body_class %}public-page{% endblock %}">
        <a href="#main-content" class="skip-link">Aller au contenu principal</a>

        <header class="site-header" role="banner">
            <div class="container site-header__inner">
                <a class="brand" href="{{ path('app_home') }}" title="Accueil du portail SIG Routes de Guadeloupe">
                    <img class="brand__logo" src="{{ asset('images/logo-rdg.jpg') }}" alt="Logo Routes de Guadeloupe">
                    <div class="brand__text">
                        <p class="brand__title">Routes de Guadeloupe</p>
                        <p class="brand__subtitle">Portail SIG public</p>
                    </div>
                </a>

                <button
                    type="button"
                    class="main-nav-toggle"
                    aria-expanded="false"
                    aria-controls="site-main-nav"
                    aria-label="Ouvrir le menu principal"
                >
                    <span class="visually-hidden">Menu principal</span>
                    <span class="main-nav-toggle__icon" aria-hidden="true"></span>
                </button>

                <nav id="site-main-nav" class="main-nav" aria-label="Navigation principale" hidden>
                    <a class="main-nav__link {{ currentRoute == 'app_content_page_show' and app.request.attributes.get('slug') == 'presentation-portail' ? 'is-active' : '' }}" href="{{ path('app_content_page_show', { slug: 'presentation-portail' }) }}" {{ currentRoute == 'app_content_page_show' and app.request.attributes.get('slug') == 'presentation-portail' ? 'aria-current="page"' : '' }}>Présentation</a>
                    <a class="main-nav__link {{ isCatalogRoute ? 'is-active' : '' }}" href="{{ path('app_data_catalog') }}" {{ isCatalogRoute ? 'aria-current="page"' : '' }}>Données et cartes</a>
                    <a class="main-nav__link {{ currentRoute starts with 'app_content_news_' ? 'is-active' : '' }}" href="{{ path('app_content_news_index') }}" {{ currentRoute starts with 'app_content_news_' ? 'aria-current="page"' : '' }}>Actualités</a>
                    <span class="main-nav__separator" aria-hidden="true"></span>

                    {% if app.user %}
                        {% set accountDisplayName = app.user.displayName ?: app.user.email %}
                        <div class="main-nav__account {{ currentRoute starts with 'agent_' or currentRoute starts with 'extranet_' ? 'is-active' : '' }}">
                            <button
                                type="button"
                                class="main-nav__account-toggle"
                                aria-label="Ouvrir le menu utilisateur"
                                aria-haspopup="true"
                                aria-expanded="false"
                                title="{{ accountDisplayName }}"
                            >
                                <span class="main-nav__account-trigger-name">{{ accountDisplayName }}</span>
                                <span class="main-nav__account-trigger-caret" aria-hidden="true">▾</span>
                            </button>

                            <div class="main-nav__account-menu" role="menu" aria-label="Menu utilisateur">
                                {% set accountParts = accountDisplayName|trim|replace({'-': ' '})|split(' ') %}
                                {% set firstInitial = accountParts|first ? accountParts|first|slice(0, 1)|upper : '' %}
                                {% set lastInitial = accountParts|length > 1 ? accountParts|last|slice(0, 1)|upper : '' %}
                                {% set accountInitials = (firstInitial ~ lastInitial)|trim %}
                                {% if accountInitials == '' %}
                                    {% set accountInitials = accountDisplayName|slice(0, 2)|upper %}
                                {% endif %}
                                <div class="main-nav__account-summary" role="note">
                                    <span class="main-nav__account-avatar" aria-hidden="true">{{ accountInitials|slice(0, 2) }}</span>
                                    <div class="main-nav__account-identity">
                                        <p class="main-nav__account-kicker">Connecté en tant que</p>
                                        <p class="main-nav__account-name">{{ accountDisplayName }}</p>
                                        <p class="main-nav__account-type">{{ app.user.typeLabel|default('Utilisateur') }}</p>
                                    </div>
                                </div>
                                <div class="main-nav__account-divider" role="separator" aria-hidden="true"></div>
                                <div class="main-nav__account-actions">
                                    <a class="main-nav__account-link" href="{{ path('app_private_home') }}" role="menuitem">Espace personnel</a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a class="main-nav__account-link" href="{{ path('admin_dashboard') }}" role="menuitem">Espace administration</a>
                                    {% endif %}
                                    <form method="post" action="{{ path('app_logout') }}" class="main-nav__logout-form">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                        <button type="submit" class="main-nav__account-link main-nav__account-link--button" role="menuitem">Déconnexion</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a
                            class="main-nav__link main-nav__auth-link {{ currentRoute == 'app_login' ? 'is-active' : '' }}"
                            href="{{ path('app_login') }}"
                            aria-label="Connexion"
                            title="Connexion"
                        >
                            Connexion
                        </a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main id="main-content" class="main" role="main">
            {% set flashes = app.flashes %}
            {% if flashes is not empty %}
                <div class="container mt-3">
                    {% for type, messages in flashes %}
                        {% for message in messages %}
                            <div class="notice {{ type == 'error' ? 'notice-error' : (type == 'info' ? 'notice-info' : 'notice-success') }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer" role="contentinfo">
            <div class="site-footer__inner">
                <div class="footer-grid">
                    <section class="footer-col">
                        <h2 class="footer-col__title">Routes de Guadeloupe</h2>
                        <p><img class="footer-col__logo" src="{{ asset('images/logo-rdg.jpg') }}" alt="Logo Routes de Guadeloupe"></p>
                        <p>Plateforme institutionnelle dédiée aux données, cartes et services SIG du territoire.</p>
                        <p>Usage grand public, partenaires, collectivités et agents.</p>
                    </section>

                    <section class="footer-col">
                        <h2 class="footer-col__title">Portail</h2>
                        <ul class="footer-links">
                            <li><a href="{{ path('app_data_catalog') }}">Données et cartes</a></li>
                            <li><a href="{{ path('app_content_page_show', { slug: 'presentation-portail' }) }}">La démarche</a></li>
                            <li><a href="{{ path('app_content_news_index') }}">Actualités</a></li>
                            <li><a href="{{ path('app_content_partners') }}">Partenaires et financeurs</a></li>
                        </ul>
                    </section>

                    <section class="footer-col">
                        <h2 class="footer-col__title">Informations légales</h2>
                        <ul class="footer-links">
                            <li><a href="{{ path('app_content_legal_mentions') }}">Mentions légales</a></li>
                            <li><a href="{{ path('app_content_legal_privacy') }}">Confidentialité</a></li>
                            <li><a href="{{ path('app_content_legal_cookies') }}">Cookies</a></li>
                            <li><a href="{{ path('app_content_legal_accessibility') }}">Accessibilité</a></li>
                        </ul>
                    </section>

                    <section class="footer-col">
                        <h2 class="footer-col__title">Support</h2>
                        <ul class="footer-links">
                            <li><a href="{{ path('app_contact') }}">Formulaire de contact</a></li>
                            {% if app.user %}
                                <li><a href="{{ path('app_private_home') }}">Mon espace privé</a></li>
                                <li>
                                    <form method="post" action="{{ path('app_logout') }}" class="footer-logout-form">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                        <button type="submit" class="footer-link-button">Déconnexion</button>
                                    </form>
                                </li>
                            {% else %}
                                <li><a href="{{ path('app_login') }}">Accès espace privé</a></li>
                                <li><a href="{{ path('app_register_external') }}">Inscription externe</a></li>
                            {% endif %}
                        </ul>
                    </section>
                </div>

                <div class="footer-meta">
                    <p class="footer-note">Portail SIG Routes de Guadeloupe - Service public territorial</p>
                    {% if app_cookie_consent_enabled is defined and app_cookie_consent_enabled %}
                        <button id="footer-cookie-open" type="button" class="footer-cookie-link">Gérer les cookies</button>
                    {% endif %}
                </div>
            </div>
        </footer>

        {% if app_cookie_consent_enabled is defined and app_cookie_consent_enabled %}
            <section
                class="cookie-consent"
                data-controller="cookie-consent"
                data-cookie-consent-enabled-value="true"
                data-cookie-consent-cookie-name-value="rdg_cookie_consent"
                data-cookie-consent-matomo-enabled-value="{{ app_matomo_enabled ? 'true' : 'false' }}"
                data-cookie-consent-matomo-site-id-value="{{ app_matomo_site_id|default(0) }}"
                data-cookie-consent-matomo-base-url-value="{{ app_matomo_base_url|default('') }}"
                aria-label="Gestion du consentement cookies"
            >
                <button type="button" class="cookie-consent__manage" data-cookie-consent-target="manageButton" data-action="cookie-consent#openPreferences" hidden>
                    Gérer mes cookies
                </button>

                <div class="cookie-consent__panel" data-cookie-consent-target="banner" role="dialog" aria-modal="true" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-description" hidden>
                    <div class="cookie-consent__panel-header">
                        <h2 id="cookie-consent-title">Gestion des cookies</h2>
                        <button type="button" class="cookie-consent__close" data-action="cookie-consent#closePreferences" aria-label="Fermer la fenêtre de gestion des cookies">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <p id="cookie-consent-description">
                        Nous utilisons uniquement des cookies nécessaires au fonctionnement du portail.
                        Vous pouvez autoriser ou refuser les cookies de mesure d’audience et de services tiers.
                    </p>
                    <p class="mb-3"><a href="{{ path('app_content_legal_cookies') }}">Consulter la politique cookies</a></p>

                    <div class="cookie-consent__actions">
                        <button type="button" class="btn btn-primary" data-cookie-consent-target="firstAction" data-action="cookie-consent#acceptAll">Tout accepter</button>
                        <button type="button" class="btn btn-outline" data-action="cookie-consent#rejectOptional">Tout refuser (hors nécessaires)</button>
                        <button type="button" class="btn btn-link" data-action="cookie-consent#showDetails">Personnaliser</button>
                    </div>

                    <div class="cookie-consent__details mt-3" data-cookie-consent-target="details" hidden>
                        <fieldset>
                            <legend>Préférences de consentement</legend>
                            <div class="cookie-consent__choice">
                                <input id="cookie-necessary" type="checkbox" checked disabled>
                                <label for="cookie-necessary">Cookies nécessaires (toujours actifs)</label>
                            </div>
                            <div class="cookie-consent__choice">
                                <input id="cookie-analytics" type="checkbox" data-cookie-consent-target="analyticsInput">
                                <label for="cookie-analytics">Mesure d’audience anonyme</label>
                            </div>
                            <div class="cookie-consent__choice">
                                <input id="cookie-services" type="checkbox" data-cookie-consent-target="servicesInput">
                                <label for="cookie-services">Services tiers intégrés</label>
                            </div>
                        </fieldset>

                        <div class="cookie-consent__actions mt-3">
                            <button type="button" class="btn btn-primary" data-action="cookie-consent#savePreferences">Enregistrer mes choix</button>
                            <button type="button" class="btn btn-link" data-action="cookie-consent#closePreferences">Fermer</button>
                        </div>
                    </div>
                </div>
            </section>
        {% endif %}

        <script>
            (() => {
                const header = document.querySelector('.site-header');
                const toggle = document.querySelector('.main-nav-toggle');
                const menu = document.getElementById('site-main-nav');

                if (!header || !toggle || !menu) {
                    return;
                }

                const mediaQuery = window.matchMedia('(min-width: 64em)');
                const revealAt = 24;
                const hideStartAt = 140;
                const hideDirectionDelta = 8;
                const showDirectionDelta = 2;
                const hideToggleDistance = 64;
                const pinnedClass = 'is-nav-pinned';
                const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
                const accountMenu = header.querySelector('.main-nav__account');
                const accountToggle = header.querySelector('.main-nav__account-toggle');

                let isMobileMenuOpen = false;
                let isAccountMenuOpen = false;
                let isHeaderCollapsed = header.classList.contains('is-nav-collapsed');
                let lastY = Math.max(window.scrollY, 0);
                let lastToggleY = lastY;
                let ticking = false;

                const setHeaderHeightVar = () => {
                    const headerHeight = Math.round(header.getBoundingClientRect().height);
                    document.documentElement.style.setProperty('--site-header-height', `${headerHeight}px`);
                };

                const getFocusableItems = () => {
                    return [...header.querySelectorAll(focusableSelector)].filter((element) => {
                        if (!(element instanceof HTMLElement) || element.hidden) {
                            return false;
                        }

                        return element.offsetParent !== null;
                    });
                };

                const setMobileMenuState = (isOpen, { restoreFocus = false } = {}) => {
                    isMobileMenuOpen = isOpen;
                    header.classList.toggle('is-mobile-menu-open', isOpen);
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu principal' : 'Ouvrir le menu principal');

                    if (isOpen) {
                        menu.hidden = false;
                        menu.setAttribute('aria-hidden', 'false');
                        document.body.classList.add('has-mobile-menu-open');
                        const firstMenuItem = menu.querySelector('a, button');
                        if (firstMenuItem instanceof HTMLElement) {
                            firstMenuItem.focus();
                        }
                    } else {
                        menu.hidden = true;
                        menu.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('has-mobile-menu-open');
                        if (restoreFocus) {
                            toggle.focus();
                        }
                    }

                    setHeaderHeightVar();
                };

                const setAccountMenuState = (isOpen) => {
                    if (!(accountMenu instanceof HTMLElement) || !(accountToggle instanceof HTMLButtonElement)) {
                        return;
                    }

                    isAccountMenuOpen = isOpen;
                    accountMenu.classList.toggle('is-open', isOpen);
                    accountToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                };

                const showDesktopHeader = ({ pinned = false } = {}) => {
                    isHeaderCollapsed = false;
                    header.classList.remove('is-nav-collapsed');
                    header.classList.toggle(pinnedClass, pinned);
                    setHeaderHeightVar();
                };

                const hideDesktopHeader = () => {
                    isHeaderCollapsed = true;
                    header.classList.remove(pinnedClass);
                    header.classList.add('is-nav-collapsed');
                    setHeaderHeightVar();
                };

                const applyMode = () => {
                    if (mediaQuery.matches) {
                        isMobileMenuOpen = false;
                        header.classList.remove('is-mobile-menu-open');
                        document.body.classList.remove('has-mobile-menu-open');
                        menu.hidden = false;
                        menu.setAttribute('aria-hidden', 'false');
                        toggle.setAttribute('aria-expanded', 'false');
                        toggle.setAttribute('aria-label', 'Ouvrir le menu principal');
                        return;
                    }

                    header.classList.remove('is-nav-collapsed', pinnedClass);
                    isHeaderCollapsed = false;
                    if (!isMobileMenuOpen) {
                        menu.hidden = true;
                        menu.setAttribute('aria-hidden', 'true');
                    }
                };

                const updateDesktopOnScroll = () => {
                    const y = Math.max(window.scrollY, 0);
                    setHeaderHeightVar();

                    if (!mediaQuery.matches) {
                        lastY = y;
                        lastToggleY = y;
                        return;
                    }

                    if (y <= revealAt) {
                        showDesktopHeader();
                        lastY = y;
                        lastToggleY = y;
                        return;
                    }

                    if (header.classList.contains(pinnedClass)) {
                        lastY = y;
                        return;
                    }

                    if (y < hideStartAt && !isHeaderCollapsed) {
                        lastY = y;
                        return;
                    }

                    const delta = y - lastY;

                    if (delta > hideDirectionDelta && !isHeaderCollapsed && y - lastToggleY >= hideToggleDistance) {
                        hideDesktopHeader();
                        lastToggleY = y;
                    } else if (delta < -showDirectionDelta && isHeaderCollapsed) {
                        showDesktopHeader();
                        lastToggleY = y;
                    }

                    lastY = y;
                };

                toggle.addEventListener('click', (event) => {
                    event.preventDefault();
                    if (mediaQuery.matches) {
                        return;
                    }

                    setMobileMenuState(!isMobileMenuOpen);
                });

                if (accountToggle instanceof HTMLButtonElement && accountMenu instanceof HTMLElement) {
                    accountToggle.addEventListener('click', (event) => {
                        event.preventDefault();

                        setAccountMenuState(!isAccountMenuOpen);
                    });
                }

                menu.addEventListener('click', (event) => {
                    if (mediaQuery.matches || !isMobileMenuOpen) {
                        return;
                    }

                    const interactiveElement = event.target.closest('a,button');
                    if (interactiveElement) {
                        setMobileMenuState(false);
                    }
                });

                document.addEventListener('pointerdown', (event) => {
                    if (isAccountMenuOpen && accountMenu instanceof HTMLElement && !accountMenu.contains(event.target)) {
                        setAccountMenuState(false);
                    }

                    if (mediaQuery.matches || !isMobileMenuOpen) {
                        return;
                    }

                    if (!header.contains(event.target)) {
                        setMobileMenuState(false);
                    }
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && isMobileMenuOpen && !mediaQuery.matches) {
                        event.preventDefault();
                        setMobileMenuState(false, { restoreFocus: true });
                        return;
                    }

                    if (event.key === 'Escape' && isAccountMenuOpen) {
                        event.preventDefault();
                        setAccountMenuState(false);
                        if (accountToggle instanceof HTMLButtonElement) {
                            accountToggle.focus();
                        }
                        return;
                    }

                    if (event.key !== 'Tab' || !isMobileMenuOpen || mediaQuery.matches) {
                        return;
                    }

                    const focusableItems = getFocusableItems();
                    if (focusableItems.length === 0) {
                        return;
                    }

                    const first = focusableItems[0];
                    const last = focusableItems[focusableItems.length - 1];
                    const active = document.activeElement;

                    if (event.shiftKey && active === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && active === last) {
                        event.preventDefault();
                        first.focus();
                    }
                });

                const onScroll = () => {
                    if (ticking) {
                        return;
                    }

                    ticking = true;
                    window.requestAnimationFrame(() => {
                        updateDesktopOnScroll();
                        ticking = false;
                    });
                };

                const onViewportChange = () => {
                    applyMode();
                    updateDesktopOnScroll();
                    setHeaderHeightVar();
                };

                window.addEventListener('scroll', onScroll, { passive: true });
                window.addEventListener('resize', onViewportChange, { passive: true });

                if (typeof mediaQuery.addEventListener === 'function') {
                    mediaQuery.addEventListener('change', onViewportChange);
                } else if (typeof mediaQuery.addListener === 'function') {
                    mediaQuery.addListener(onViewportChange);
                }

                header.addEventListener('focusin', () => {
                    if (mediaQuery.matches) {
                        showDesktopHeader({ pinned: true });
                    }
                });
                header.addEventListener('focusout', () => {
                    if (!mediaQuery.matches) {
                        return;
                    }

                    window.setTimeout(() => {
                        if (!header.contains(document.activeElement)) {
                            header.classList.remove(pinnedClass);
                        }
                    }, 0);
                });
                header.addEventListener('mouseenter', () => {
                    if (mediaQuery.matches) {
                        showDesktopHeader({ pinned: true });
                    }
                });
                header.addEventListener('mouseleave', () => {
                    if (mediaQuery.matches) {
                        header.classList.remove(pinnedClass);
                    }
                });

                applyMode();
                updateDesktopOnScroll();
                setHeaderHeightVar();
            })();

            (() => {
                const footerCookieButton = document.getElementById('footer-cookie-open');
                if (!footerCookieButton) {
                    return;
                }

                footerCookieButton.addEventListener('click', (event) => {
                    event.preventDefault();

                    const consentRoot = document.querySelector('.cookie-consent');
                    if (!consentRoot) {
                        return;
                    }

                    const manageButton = consentRoot?.querySelector('[data-cookie-consent-target="manageButton"]');
                    if (manageButton instanceof HTMLButtonElement) {
                        manageButton.click();
                    }

                    window.dispatchEvent(new CustomEvent('cookie-consent:open', { detail: { showDetails: true } }));
                });
            })();
        </script>
    </body>
</html>
