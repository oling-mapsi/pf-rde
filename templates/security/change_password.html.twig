{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_private_home') }}">Mon espace</a></li>
                    <li aria-current="page">Changer mon mot de passe</li>
                </ol>
            </nav>

            <section class="card form-panel auth-panel">
                <h1>Changer mon mot de passe</h1>
                <p class="text-muted">Choisissez un mot de passe d’au moins {{ passwordMinLength }} caractères.</p>

                {{ form_start(form) }}
                    {{ form_row(form.currentPassword) }}
                    {{ form_row(form.newPassword.first) }}
                    {{ form_row(form.newPassword.second) }}
                    <button type="submit" class="btn btn-primary">Mettre à jour</button>
                {{ form_end(form) }}
            </section>
        </div>
    </section>
{% endblock %}

