{% extends 'base.html.twig' %}

{% block title %}Inscription espace privé{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li aria-current="page">Inscription espace privé</li>
                </ol>
            </nav>

            <section class="card form-panel auth-panel">
                <h1>Créer un compte externe</h1>
                <p class="text-muted">Les comptes externes peuvent demander un accès aux ressources privées.</p>

                {{ form_start(form) }}
                    {{ form_row(form.userType) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.organizationName) }}
                    {{ form_row(form.websiteUrl) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.password.first) }}
                    {{ form_row(form.password.second) }}
                    <button type="submit" class="btn btn-primary">Créer mon compte</button>
                {{ form_end(form) }}

                <p class="mt-3">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
            </section>
        </div>
    </section>
{% endblock %}
