{% extends 'base.html.twig' %}

{% block title %}Connexion agents{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li aria-current="page">Connexion agents</li>
                </ol>
            </nav>

            <section class="card form-panel auth-panel">
                <h1>Connexion espace agents</h1>
                <p class="text-muted">Acces securise reserve aux agents habilites.</p>

                {% if error %}
                    <div class="notice notice-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" autocomplete="email" value="{{ last_username }}" required>

                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary">Se connecter</button>
                </form>
            </section>
        </div>
    </section>
{% endblock %}
