{% extends 'base.html.twig' %}

{% block title %}Connexion espace privé{% endblock %}

{% block body %}
    <section class="page-shell">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li aria-current="page">Connexion espace privé</li>
                </ol>
            </nav>

            <section class="card form-panel auth-panel">
                <h1>Connexion espace privé</h1>
                <p class="text-muted">Accès sécurisé pour agents, professionnels, entreprises et partenaires enregistrés.</p>

                {% if error %}
                    <div class="notice notice-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" autocomplete="email" value="{{ last_username }}" required>

                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary">Se connecter</button>
                </form>

                <p class="mt-3">
                    <a class="btn btn-outline" href="{{ path('app_sso_login') }}">Se connecter avec Microsoft 365 (SSO)</a>
                </p>

                <p class="mt-3">
                    Vous n’avez pas encore de compte externe ?
                    <a href="{{ path('app_register_external') }}">Créer un compte</a>
                </p>
            </section>
        </div>
    </section>
{% endblock %}
