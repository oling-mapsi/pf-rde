{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande agent{% endblock %}

{% block body %}
    <section class="page-shell page-shell--agent">
        <div class="container container--content">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('agent_dashboard') }}">Espace agents</a></li>
                    <li aria-current="page">Nouvelle demande</li>
                </ol>
            </nav>

            <header class="page-header">
                <p class="page-header__eyebrow">
                    <span class="section-icon section-icon--green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8"/></svg>
                    </span>
                    <span>Soumission de demande</span>
                </p>
                <h1 class="page-header__title">Nouvelle demande SIG</h1>
                <p class="page-header__lead">Saisissez votre besoin, joignez les éléments utiles puis suivez le traitement depuis votre tableau de bord.</p>
            </header>

            <section class="card form-panel request-form-shell" data-controller="agent-request-submission">
                <div class="request-form-shell__legal">
                    <p><strong>Délais indicatifs :</strong> normal 1 à 2 semaines, urgent moins de 5 jours ouvrés, très urgent moins de 48h sous réserve.</p>
                    <p><strong>Traçabilité :</strong> précisez autant que possible l’emprise, le contexte métier et la destination de la production.</p>
                </div>

                {{ form_start(form) }}
                    <div class="request-form-layout">
                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Profil demandeur</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.structureType) }}</div>
                                <div>{{ form_row(form.directionService) }}</div>
                                <div>{{ form_row(form.center) }}</div>
                                <div>{{ form_row(form.orderReference) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Coordonnées</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.lastName) }}</div>
                                <div>{{ form_row(form.firstName) }}</div>
                                <div>{{ form_row(form.email) }}</div>
                                <div>{{ form_row(form.emailConfirmation) }}</div>
                                <div>{{ form_row(form.phoneNumber) }}</div>
                                <div>{{ form_row(form.urgencyLevel) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.urgencyJustification) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Expression du besoin</h2>
                            </div>
                            <div class="request-form-grid">
                                <div class="request-form-grid__full">{{ form_row(form.subject) }}</div>
                                <div>{{ form_row(form.requestKinds) }}</div>
                                <div>{{ form_row(form.networkTypes) }}</div>
                                <div>{{ form_row(form.routeDetails) }}</div>
                                <div>{{ form_row(form.geographicArea) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.description) }}</div>
                                <div class="request-form-grid__full">{{ form_row(form.additionalInformation) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Livrables</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.hasProvidedData) }}</div>
                                <div>{{ form_row(form.deliveryDestination) }}</div>
                                <div>{{ form_row(form.dataFormats) }}</div>
                                <div>{{ form_row(form.projectionSystem) }}</div>
                                <div>{{ form_row(form.mapFormats) }}</div>
                                <div>{{ form_row(form.mapScale) }}</div>
                            </div>
                        </section>

                        <section class="request-form-section">
                            <div class="request-form-section__head">
                                <h2 class="request-form-section__title">Pièces jointes</h2>
                            </div>
                            <div class="request-form-grid">
                                <div>{{ form_row(form.attachment) }}</div>
                                <div>{{ form_row(form.attachmentDescription) }}</div>
                            </div>
                        </section>
                    </div>
                    <button type="submit" class="btn btn-primary">Soumettre la demande</button>
                {{ form_end(form) }}
            </section>
        </div>
    </section>
{% endblock %}
